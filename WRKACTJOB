#!/usr/bin/env python3
import os
import sys
import curses
import sqlite3
import time
import errno

DB_PATH = "/var/lib/os400/qsys.db"

# Cache: Module-level dict storing (prev_total_ticks, prev_ts) per PID
cpu_cache = {}

def get_cpu_usage(pid):
    """Calculates CPU% over an elapsed delta window normalized for system core count."""
    if pid <= 0:
        return 0.0
        
    global cpu_cache
    now = time.time()
    
    try:
        # Read /proc/<pid>/stat (world-readable on standard Linux environments)
        with open(f"/proc/{pid}/stat", "r") as f:
            stat_content = f.read().strip()
            
        right_parenthesis = stat_content.rfind(')')
        if right_parenthesis == -1:
            return 0.0
            
        stat_line = stat_content[right_parenthesis + 2:].split()
        
        utime = float(stat_line[11])
        stime = float(stat_line[12])
        total_ticks = utime + stime
        
        prev = cpu_cache.get(pid)
        cpu_pct = 0.0
        
        if prev:
            prev_total_ticks, prev_ts = prev
            elapsed_seconds = now - prev_ts
            clk_tck = os.sysconf(os.sysconf_names['SC_CLK_TCK'])
            
            if elapsed_seconds > 0:
                cores = os.cpu_count() or 1
                cpu_pct = (((total_ticks - prev_total_ticks) / (elapsed_seconds * clk_tck)) * 100.0) * cores
                
        cpu_cache[pid] = (total_ticks, now)
        return round(max(0.0, cpu_pct), 1)
        
    except (FileNotFoundError, IndexError, ValueError, OSError):
        return 0.0

def update_and_get_jobs():
    """Queries jobs from DB, verifies if Linux PIDs live, updates status safely across users."""
    if not os.path.exists(DB_PATH):
        return []
        
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT job_number, job_name, user, pid, status, command 
        FROM active_jobs 
        WHERE status IN ('*RUNNING', '*JOBQ') 
        ORDER BY job_number DESC
    """)
    jobs = cursor.fetchall()
    
    updated_jobs = []
    for job in jobs:
        job_num, job_name, user, pid, status, command = job
        padded_num = f"{job_num:06d}"
        cpu = 0.0
        
        if status == '*RUNNING' and pid > 0:
            try:
                os.kill(pid, 0) # Check if Linux process is alive
                cpu = get_cpu_usage(pid)
            except PermissionError:
                # MULTI-USER FIX: Process is alive but owned by another user.
                # Do not change database status. Still allowed to read CPU tick metrics.
                cpu = get_cpu_usage(pid)
            except ProcessLookupError:
                # Process is genuinely dead. Safely move to OUTQ.
                status = '*OUTQ'
                cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
                conn.commit()
            except OSError as e:
                # Fallback check for older Python environments mapping errnos manually
                if e.errno == errno.ESRCH:
                    status = '*OUTQ'
                    cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
                    conn.commit()
                
        if status in ('*RUNNING', '*JOBQ'):
            updated_jobs.append({
                'num': padded_num,
                'raw_num': job_num,
                'name': job_name,
                'user': user,
                'pid': pid,
                'status': status,
                'cpu': cpu,
                'cmd': command
            })
            
    conn.close()
    return updated_jobs

def kill_job(job_num, pid):
    """Executes Option 4 (End Job) by killing the target process group securely."""
    if pid > 0:
        try:
            pgid = os.getpgid(pid)
            os.kill(-pgid, 9)
        except PermissionError:
            return "CPF1389: Not authorized to clear or end another user's job."
        except OSError:
            try:
                os.kill(pid, 9)
            except PermissionError:
                return "CPF1389: Not authorized to clear or end another user's job."
            except OSError:
                pass
            
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
    conn.commit()
    conn.close()
    return None

def view_spool(stdscr, job_num):
    """Executes Option 5 to view the spooled stdout text file."""
    spool_path = f"/var/lib/os400/splf/JOB_{job_num:06d}.txt"
    stdscr.clear()
    stdscr.refresh()
    
    lines = []
    if os.path.exists(spool_path):
        try:
            with open(spool_path, "r") as f:
                lines = f.readlines()
        except OSError:
            lines = ["CPF2204: Not authorized to access this job's spool file."]
    else:
        lines = ["CPF2204: Spool file not found or not generated yet."]

    current_line = 0
    stdscr.nodelay(False) 
    
    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()
        
        stdscr.addstr(0, 2, f"Display Spooled File: JOB_{job_num:06d}.txt", curses.color_pair(2))
        stdscr.addstr(1, 2, "F12=Cancel / Return to WRKACTJOB", curses.color_pair(1))
        stdscr.hline(2, 0, '-', width)
        
        for i in range(height - 4):
            line_idx = current_line + i
            if line_idx < len(lines):
                stdscr.addstr(3 + i, 2, lines[line_idx][:width-4].rstrip())
                
        stdscr.refresh()
        ch = stdscr.getch()
        
        if ch in (curses.KEY_F12, ord('q'), ord('Q'), ord('c'), ord('C'), 27):
            break
        elif ch == curses.KEY_DOWN and current_line < len(lines) - (height - 4):
            current_line += 1
        elif ch == curses.KEY_UP and current_line > 0:
            current_line -= 1

def draw_screen(stdscr):
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)   
    curses.init_pair(2, curses.COLOR_WHITE, -1)   
    curses.init_pair(3, curses.COLOR_RED, -1)     # For showing permission errors standard across commands
    curses.init_pair(4, curses.COLOR_CYAN, -1)    
    
    stdscr.nodelay(True)
    stdscr.timeout(1000) 
    
    inputs = {} 
    current_row_idx = 0  
    error_msg = ""
    
    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()
        
        jobs = update_and_get_jobs()
        
        if current_row_idx >= len(jobs):
            current_row_idx = max(0, len(jobs) - 1)
        
        stdscr.addstr(0, 2, "Work with Active Jobs", curses.color_pair(1))
        stdscr.addstr(0, width - 24, "OS400-LINUX SYSTEM", curses.color_pair(1))
        
        curr_time = time.strftime("%Y-%m-%d  %H:%M:%S")
        stdscr.addstr(1, width - 24, curr_time, curses.color_pair(2))
        
        total_cpu = sum(j['cpu'] for j in jobs)
        stdscr.addstr(2, 2, f"CPU %: {total_cpu:5.1f}      Active Jobs: {len(jobs):5d}", curses.color_pair(1))
        
        stdscr.addstr(4, 2, "Type options, press Enter.", curses.color_pair(1))
        stdscr.addstr(5, 4, "4=End job   5=Work with spool file", curses.color_pair(4))
        
        stdscr.addstr(7, 2, "Opt  Job/Subsys  User        Type    CPU %  Status    Command", curses.color_pair(1))
        stdscr.hline(8, 0, '-', width)
        
        row = 9
        new_inputs = {}
        for idx, job in enumerate(jobs):
            if row >= height - 4: 
                break 
                
            opt_val = inputs.get(idx, "")
            
            stdscr.addstr(row, 2, "[ ]", curses.color_pair(1))
            if opt_val:
                stdscr.addstr(row, 3, opt_val, curses.color_pair(2))
                
            stdscr.addstr(row, 7, f"{job['name'][:10]:12}", curses.color_pair(2))
            stdscr.addstr(row, 20, f"{job['user'][:10]:12}", curses.color_pair(2))
            stdscr.addstr(row, 34, "BCH", curses.color_pair(4))
            stdscr.addstr(row, 42, f"{job['cpu']:5.1f}", curses.color_pair(2))
            stdscr.addstr(row, 49, f"{job['status']:10}", curses.color_pair(1 if job['status'] == '*RUNNING' else 2))
            stdscr.addstr(row, 59, f"{job['cmd'][:width-61]}", curses.color_pair(2))
            
            new_inputs[idx] = { 'val': opt_val, 'y': row, 'x': 3, 'job': job }
            row += 1
            
        inputs = { k: v['val'] for k, v in new_inputs.items() }
        
        if error_msg:
            stdscr.addstr(height - 3, 2, error_msg, curses.color_pair(3))
            
        legend_str = "F3=Exit   F5=Refresh   F12=Cancel"
        stdscr.addstr(height - 2, 2, legend_str, curses.color_pair(1))
        
        if new_inputs and current_row_idx in new_inputs:
            stdscr.move(new_inputs[current_row_idx]['y'], new_inputs[current_row_idx]['x'])
        else:
            stdscr.move(height - 2, 2)
            
        stdscr.refresh()
        
        ch = stdscr.getch()
        if ch != -1:
            error_msg = ""
        
        if ch in (curses.KEY_F3, ord('q'), ord('Q'), ord('x'), ord('X'), 27):
            break
        elif ch in (curses.KEY_F5, ord('r'), ord('R')):
            continue
        elif ch == curses.KEY_UP:
            if current_row_idx > 0:
                current_row_idx -= 1
        elif ch == curses.KEY_DOWN:
            if current_row_idx < len(jobs) - 1:
                current_row_idx += 1
        elif ch in (ord('4'), ord('5'), ord(' ')):
            if jobs: 
                char_str = " " if ch == ord(' ') else chr(ch)
                inputs[current_row_idx] = char_str.strip()
        elif ch == 10: 
            for idx, info in new_inputs.items():
                val = inputs.get(idx, "")
                if val == "4":
                    err = kill_job(info['job']['raw_num'], info['job']['pid'])
                    if err:
                        error_msg = err
                elif val == "5":
                    view_spool(stdscr, info['job']['raw_num'])
                    stdscr.nodelay(True)
                    stdscr.timeout(1000)
            inputs = {}

if __name__ == "__main__":
    curses.wrapper(draw_screen)