#!/usr/bin/env python3
import os
import sys
import curses
import sqlite3
import time
import errno

DB_PATH = "/var/lib/os400/qsys.db"

# Cache: Module-level dict storing (prev_total_tree_ticks, prev_ts) per parent PID
cpu_cache = {}

def get_system_proc_snapshot():
    """
    Scans /proc exactly once per refresh cycle.
    Returns a dictionary mapping: pid -> {'ppid': parent_pid, 'ticks': total_ticks}
    """
    snapshot = {}
    try:
        for d in os.listdir('/proc'):
            if d.isdigit():
                try:
                    pid = int(d)
                    with open(f"/proc/{d}/stat", "r") as f:
                        content = f.read().strip()
                        
                    r_paren = content.rfind(')')
                    if r_paren == -1:
                        continue
                        
                    stat_line = content[r_paren + 2:].split()
                    
                    # Layout mappings from /proc/[pid]/stat text tokens
                    ppid = int(stat_line[1])       # Field 4 in raw stat
                    utime = float(stat_line[11])   # Field 14 in raw stat
                    stime = float(stat_line[12])   # Field 15 in raw stat
                    
                    snapshot[pid] = {
                        'ppid': ppid,
                        'ticks': utime + stime
                    }
                except (FileNotFoundError, PermissionError, IndexError, ValueError):
                    continue
    except OSError:
        pass
    return snapshot

def get_cpu_usage(pid, snapshot):
    """
    Calculates CPU% over an elapsed delta window by aggregating the ticks
    of the parent process AND ALL of its deep descendants (children, grandchildren, workers).
    """
    if pid <= 0:
        return 0.0
        
    global cpu_cache
    now = time.time()
    
    # 1. Map every parent PID to its direct children from our global snapshot
    ppid_to_children = {}
    for c_pid, info in snapshot.items():
        ppid_to_children.setdefault(info['ppid'], []).append(c_pid)
        
    # 2. Level-order traversal (BFS) to gather ALL family tree descendants
    family_tree_pids = [pid]
    queue = [pid]
    
    while queue:
        curr_parent = queue.pop(0)
        if curr_parent in ppid_to_children:
            for child in ppid_to_children[curr_parent]:
                family_tree_pids.append(child)
                queue.append(child) # Push child to queue to search for grandchildren
                
    # 3. Sum up ticks across the entire gathered family tree
    total_tree_ticks = 0.0
    for p in family_tree_pids:
        if p in snapshot:
            total_tree_ticks += snapshot[p]['ticks']
            
    # 4. Standard timeline delta window calculation
    prev = cpu_cache.get(pid)
    cpu_pct = 0.0
    
    if prev:
        prev_total_ticks, prev_ts = prev
        elapsed_seconds = now - prev_ts
        
        try:
            clk_tck = os.sysconf('SC_CLK_TCK')
        except (ValueError, OSError, AttributeError):
            clk_tck = 100  # Fallback to standard x86_64 architecture tick metrics
            
        if elapsed_seconds > 0:
            # Option A: Core tracking remains absolute
            cpu_pct = ((total_tree_ticks - prev_total_ticks) / (elapsed_seconds * clk_tck)) * 100.0
                
    cpu_cache[pid] = (total_tree_ticks, now)
    return round(max(0.0, cpu_pct), 1)

def update_and_get_jobs():
    """Queries jobs from DB, verifies if Linux PIDs live, updates status safely across users."""
    if not os.path.exists(DB_PATH):
        return []
        
    # Take ONE global process snapshot before scanning database items
    proc_snapshot = get_system_proc_snapshot()
        
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT job_number, job_name, user, pid, status, command 
        FROM active_jobs 
        WHERE status IN ('*RUNNING', '*JOBQ') 
        ORDER BY job_number DESC
    """)
    jobs = cursor.fetchall()
    
    updated_jobs = []
    for job in jobs:
        job_num, job_name, user, pid, status, command = job
        padded_num = f"{job_num:06d}"
        cpu = 0.0
        
        if status == '*RUNNING' and pid > 0:
            try:
                os.kill(pid, 0) # Confirm if process or parent container is alive
                cpu = get_cpu_usage(pid, proc_snapshot)
            except PermissionError:
                # MULTI-USER SAFETY: Process lives but belongs to another user.
                # Do not move to OUTQ; calculate CPU using global tree snapshot metrics.
                cpu = get_cpu_usage(pid, proc_snapshot)
            except ProcessLookupError:
                status = '*OUTQ'
                cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
                conn.commit()
            except OSError as e:
                if e.errno == errno.ESRCH:
                    status = '*OUTQ'
                    cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
                    conn.commit()
                
        if status in ('*RUNNING', '*JOBQ'):
            updated_jobs.append({
                'num': padded_num,
                'raw_num': job_num,
                'name': job_name,
                'user': user,
                'pid': pid,
                'status': status,
                'cpu': cpu,
                'cmd': command
            })
            
    conn.close()
    return updated_jobs

def kill_job(job_num, pid):
    """Executes Option 4 (End Job) securely handling multi-user permission constraints."""
    if pid > 0:
        try:
            pgid = os.getpgid(pid)
            os.kill(-pgid, 9)
        except PermissionError:
            return "CPF1389: Not authorized to clear or end another user's job."
        except OSError:
            try:
                os.kill(pid, 9)
            except PermissionError:
                return "CPF1389: Not authorized to clear or end another user's job."
            except OSError:
                pass
            
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
    conn.commit()
    conn.close()
    return None

def view_spool(stdscr, job_num):
    """Executes Option 5 to view the spooled text output file with full scroll controls."""
    spool_path = f"/var/lib/os400/splf/JOB_{job_num:06d}.txt"
    stdscr.clear()
    stdscr.refresh()
    
    lines = []
    if os.path.exists(spool_path):
        try:
            with open(spool_path, "r") as f:
                lines = f.readlines()
        except OSError:
            lines = ["CPF2204: Not authorized to access this job's spool file."]
    else:
        lines = ["CPF2204: Spool file not found or not generated yet."]

    current_line = 0
    stdscr.nodelay(False) 
    
    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()
        
        stdscr.addstr(0, 2, f"Display Spooled File: JOB_{job_num:06d}.txt", curses.color_pair(2))
        stdscr.addstr(1, 2, "F12=Cancel / Return to WRKACTJOB", curses.color_pair(1))
        stdscr.hline(2, 0, '-', width)
        
        for i in range(height - 4):
            line_idx = current_line + i
            if line_idx < len(lines):
                stdscr.addstr(3 + i, 2, lines[line_idx][:width-4].rstrip())
                
        stdscr.refresh()
        ch = stdscr.getch()
        
        if ch in (curses.KEY_F12, ord('q'), ord('Q'), ord('c'), ord('C'), 27):
            break
        elif ch in (curses.KEY_DOWN, curses.KEY_NPAGE):
            step = (height - 4) if ch == curses.KEY_NPAGE else 1
            if current_line < len(lines) - (height - 4):
                current_line = min(len(lines) - (height - 4), current_line + step)
        elif ch in (curses.KEY_UP, curses.KEY_PPAGE):
            step = (height - 4) if ch == curses.KEY_PPAGE else 1
            if current_line > 0:
                current_line = max(0, current_line - step)

def draw_screen(stdscr):
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)   
    curses.init_pair(2, curses.COLOR_WHITE, -1)   
    curses.init_pair(3, curses.COLOR_RED, -1)     
    curses.init_pair(4, curses.COLOR_CYAN, -1)    
    
    stdscr.nodelay(True)
    stdscr.timeout(1000) 
    
    # Subfile input accumulation mapping: raw_job_number -> user option typed
    pending_options = {} 
    current_row_idx = 0  
    scroll_top = 0
    error_msg = ""
    
    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()
        
        jobs = update_and_get_jobs()
        
        if current_row_idx >= len(jobs):
            current_row_idx = max(0, len(jobs) - 1)
        
        # dynamic page bounds calculation
        max_jobs_per_page = max(1, height - 13)
        
        # Frame boundary updates
        if current_row_idx < scroll_top:
            scroll_top = current_row_idx
        elif current_row_idx >= scroll_top + max_jobs_per_page:
            scroll_top = current_row_idx - max_jobs_per_page + 1
            
        if scroll_top > max(0, len(jobs) - max_jobs_per_page):
            scroll_top = max(0, len(jobs) - max_jobs_per_page)
        
        # Headers Layout
        stdscr.addstr(0, 2, "Work with Active Jobs", curses.color_pair(1))
        stdscr.addstr(0, width - 24, "OS400-LINUX SYSTEM", curses.color_pair(1))
        
        curr_time = time.strftime("%Y-%m-%d  %H:%M:%S")
        stdscr.addstr(1, width - 24, curr_time, curses.color_pair(2))
        
        total_cpu = sum(j['cpu'] for j in jobs)
        stdscr.addstr(2, 2, f"CPU %: {total_cpu:5.1f}      Active Jobs: {len(jobs):5d}", curses.color_pair(1))
        
        stdscr.addstr(4, 2, "Type options, press Enter.", curses.color_pair(1))
        stdscr.addstr(5, 4, "4=End job   5=Work with spool file", curses.color_pair(4))
        
        stdscr.addstr(7, 2, "Opt  Job/Subsys  User        Type    CPU %  Status    Command", curses.color_pair(1))
        stdscr.hline(8, 0, '-', width)
        
        # Subfile Pagination Indicators
        if len(jobs) > max_jobs_per_page:
            if scroll_top + max_jobs_per_page < len(jobs):
                stdscr.addstr(7, width - 12, "More...", curses.color_pair(4))
            else:
                stdscr.addstr(7, width - 12, "Bottom", curses.color_pair(4))

        row = 9
        cursor_coords = None
        visible_jobs = jobs[scroll_top : scroll_top + max_jobs_per_page]
        
        for idx, job in enumerate(visible_jobs):
            absolute_idx = scroll_top + idx
            opt_val = pending_options.get(job['raw_num'], "")
            
            stdscr.addstr(row, 2, "[ ]", curses.color_pair(1))
            if opt_val:
                stdscr.addstr(row, 3, opt_val, curses.color_pair(2))
                
            stdscr.addstr(row, 7, f"{job['name'][:10]:12}", curses.color_pair(2))
            stdscr.addstr(row, 20, f"{job['user'][:10]:12}", curses.color_pair(2))
            stdscr.addstr(row, 34, "BCH", curses.color_pair(4))
            stdscr.addstr(row, 42, f"{job['cpu']:5.1f}", curses.color_pair(2))
            stdscr.addstr(row, 49, f"{job['status']:10}", curses.color_pair(1 if job['status'] == '*RUNNING' else 2))
            stdscr.addstr(row, 59, f"{job['cmd'][:width-61]}", curses.color_pair(2))
            
            if absolute_idx == current_row_idx:
                cursor_coords = (row, 3)
                
            row += 1
            
        if error_msg:
            stdscr.addstr(height - 3, 2, error_msg, curses.color_pair(3))
            
        legend_str = "F3=Exit   F5=Refresh   F12=Cancel   PageUp/Dn=Roll"
        stdscr.addstr(height - 2, 2, legend_str, curses.color_pair(1))
        
        if cursor_coords:
            stdscr.move(cursor_coords[0], cursor_coords[1])
        else:
            stdscr.move(height - 2, 2)
            
        stdscr.refresh()
        ch = stdscr.getch()
        
        if ch != -1:
            error_msg = "" 
        
        if ch in (curses.KEY_F3, ord('q'), ord('Q'), ord('x'), ord('X'), 27):
            break
        elif ch in (curses.KEY_F5, ord('r'), ord('R')):
            continue
        elif ch == curses.KEY_UP:
            if current_row_idx > 0:
                current_row_idx -= 1
        elif ch == curses.KEY_DOWN:
            if current_row_idx < len(jobs) - 1:
                current_row_idx += 1
        elif ch == curses.KEY_PPAGE: 
            if current_row_idx > 0:
                current_row_idx = max(0, current_row_idx - max_jobs_per_page)
        elif ch == curses.KEY_NPAGE: 
            if current_row_idx < len(jobs) - 1:
                current_row_idx = min(len(jobs) - 1, current_row_idx + max_jobs_per_page)
        elif ch in (ord('4'), ord('5'), ord(' ')):
            if jobs and current_row_idx < len(jobs): 
                target_job = jobs[current_row_idx]
                char_str = " " if ch == ord(' ') else chr(ch)
                
                if char_str.strip() == "":
                    pending_options.pop(target_job['raw_num'], None)
                else:
                    pending_options[target_job['raw_num']] = char_str
        elif ch == 10: 
            # Process accumulated choices across all active pages
            for job_num, val in list(pending_options.items()):
                target_job = next((j for j in jobs if j['raw_num'] == job_num), None)
                if target_job:
                    if val == "4":
                        err = kill_job(target_job['raw_num'], target_job['pid'])
                        if err:
                            error_msg = err
                    elif val == "5":
                        view_spool(stdscr, target_job['raw_num'])
                        stdscr.nodelay(True)
                        stdscr.timeout(1000)
            pending_options = {}

if __name__ == "__main__":
    curses.wrapper(draw_screen)