#!/usr/bin/env python3
import os
import sys
import curses
import sqlite3
import time

DB_PATH = "/var/lib/os400/qsys.db"

# Global cache to store the PREVIOUS snapshot of ticks for delta calculations
# Format: { pid: (last_total_ticks, last_sample_time) }
CPU_HISTORY = {}

def get_cpu_usage(pid):
    """Calculates real-time process CPU usage including child threads via task tree delta matching."""
    if pid <= 0:
        return 0.0
        
    global CPU_HISTORY
    now = time.time()
    
    try:
        total_ticks = 0.0
        
        # 1. Read the parent process statistics frame
        with open(f"/proc/{pid}/stat", "r") as f:
            stat_content = f.read().strip()
        r_paren = stat_content.rfind(')')
        if r_paren != -1:
            stat_line = stat_content[r_paren + 2:].split()
            # Aggregate: utime(11), stime(12), cutime(13), cstime(14)
            total_ticks += sum(float(stat_line[i]) for i in [11, 12, 13, 14])
            
        # 2. Extract hidden sub-thread workloads inside the kernel task architecture
        task_dir = f"/proc/{pid}/task"
        if os.path.exists(task_dir):
            for tid in os.listdir(task_dir):
                try:
                    with open(f"{task_dir}/{tid}/stat", "r") as f:
                        t_content = f.read().strip()
                    tr_paren = t_content.rfind(')')
                    if tr_paren != -1:
                        t_line = t_content[tr_paren + 2:].split()
                        # Aggregate thread user and system runtime ticks
                        total_ticks += sum(float(t_line[i]) for i in [11, 12])
                except (FileNotFoundError, IndexError, ValueError):
                    continue

        # 3. User-Provided Cache Performance Delta Matching
        prev = CPU_HISTORY.get(pid)
        cpu_pct = 0.0
        
        if prev:
            prev_total, prev_ts = prev
            dt = now - prev_ts
            clk_tck = os.sysconf(os.sysconf_names['SC_CLK_TCK'])
            
            if dt > 0:
                # Delta calculations using structural ticks over elapsed seconds
                cpu_pct = ((total_ticks - prev_total) / (dt * clk_tck)) * 100.0
                
        CPU_HISTORY[pid] = (total_ticks, now)
        return round(max(0.0, cpu_pct), 1)
        
    except (FileNotFoundError, IndexError, ValueError):
        if pid in CPU_HISTORY:
            del CPU_HISTORY[pid]
            
    return 0.0

def update_and_get_jobs():
    """Queries jobs from DB, verifies if Linux PIDs live, updates status."""
    if not os.path.exists(DB_PATH):
        return []
        
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT job_number, job_name, user, pid, status, command 
        FROM active_jobs 
        WHERE status IN ('*RUNNING', '*JOBQ') 
        ORDER BY job_number DESC
    """)
    jobs = cursor.fetchall()
    
    updated_jobs = []
    active_pids = set()
    
    for job in jobs:
        job_num, job_name, user, pid, status, command = job
        padded_num = f"{job_num:06d}"
        cpu = 0.0
        
        if status == '*RUNNING' and pid > 0:
            try:
                os.kill(pid, 0) # Check if Linux process is alive
                cpu = get_cpu_usage(pid)
                active_pids.add(pid)
            except OSError:
                status = '*OUTQ'
                cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
                conn.commit()
                
        if status in ('*RUNNING', '*JOBQ'):
            updated_jobs.append({
                'num': padded_num,
                'raw_num': job_num,
                'name': job_name,
                'user': user,
                'pid': pid,
                'status': status,
                'cpu': cpu,
                'cmd': command
            })
            
    # Purge old dead metrics out of memory cache
    global CPU_HISTORY
    for stale_pid in list(CPU_HISTORY.keys()):
        if stale_pid not in active_pids:
            del CPU_HISTORY[stale_pid]
            
    conn.close()
    return updated_jobs

def kill_job(job_num, pid):
    """Executes Option 4 (End Job) by killing the target process group."""
    if pid > 0:
        try:
            pgid = os.getpgid(pid)
            os.kill(-pgid, 9)
        except OSError:
            try:
                os.kill(pid, 9)
            except OSError:
                pass
            
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
    conn.commit()
    conn.close()

def view_spool(stdscr, job_num):
    """Executes Option 5 to view the spooled stdout text file."""
    spool_path = f"/var/lib/os400/splf/JOB_{job_num:06d}.txt"
    stdscr.clear()
    stdscr.refresh()
    
    lines = []
    if os.path.exists(spool_path):
        with open(spool_path, "r") as f:
            lines = f.readlines()
    else:
        lines = ["CPF2204: Spool file not found or not generated yet."]

    current_line = 0
    stdscr.nodelay(False) 
    
    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()
        
        stdscr.addstr(0, 2, f"Display Spooled File: JOB_{job_num:06d}.txt", curses.color_pair(2))
        stdscr.addstr(1, 2, "F12=Cancel / Return to WRKACTJOB", curses.color_pair(1))
        stdscr.hline(2, 0, '-', width)
        
        for i in range(height - 4):
            line_idx = current_line + i
            if line_idx < len(lines):
                stdscr.addstr(3 + i, 2, lines[line_idx][:width-4].rstrip())
                
        stdscr.refresh()
        ch = stdscr.getch()
        
        if ch in (curses.KEY_F12, ord('q'), ord('Q'), ord('c'), ord('C'), 27):
            break
        elif ch == curses.KEY_DOWN and current_line < len(lines) - (height - 4):
            current_line += 1
        elif ch == curses.KEY_UP and current_line > 0:
            current_line -= 1

def draw_screen(stdscr):
    # Setup Terminal Colors (Classic IBM Green Screen Matrix Style)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)   # Primary Framework Elements
    curses.init_pair(2, curses.COLOR_WHITE, -1)   # Text variables / data entries
    curses.init_pair(4, curses.COLOR_CYAN, -1)    # Dynamic attributes labels
    
    stdscr.nodelay(True)
    stdscr.timeout(1000) 
    
    inputs = {} 
    current_row_idx = 0  # Locks cursor row position between ticks
    
    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()
        
        jobs = update_and_get_jobs()
        
        # Enforce bounds alignment on current active tracker indexes
        if current_row_idx >= len(jobs):
            current_row_idx = max(0, len(jobs) - 1)
        
        # 1. Header Layout
        stdscr.addstr(0, 2, "Work with Active Jobs", curses.color_pair(1))
        stdscr.addstr(0, width - 24, "OS400-LINUX SYSTEM", curses.color_pair(1))
        
        curr_time = time.strftime("%Y-%m-%d  %H:%M:%S")
        stdscr.addstr(1, width - 24, curr_time, curses.color_pair(2))
        
        total_cpu = sum(j['cpu'] for j in jobs)
        stdscr.addstr(2, 2, f"CPU %: {total_cpu:5.1f}      Active Jobs: {len(jobs):5d}", curses.color_pair(1))
        
        stdscr.addstr(4, 2, "Type options, press Enter.", curses.color_pair(1))
        stdscr.addstr(5, 4, "4=End job   5=Work with spool file", curses.color_pair(4))
        
        # 2. Main Columns Line Header
        stdscr.addstr(7, 2, "Opt  Job/Subsys  User        Type    CPU %  Status    Command", curses.color_pair(1))
        stdscr.hline(8, 0, '-', width)
        
        # 3. Dynamic Rows Loop
        row = 9
        new_inputs = {}
        for idx, job in enumerate(jobs):
            if row >= height - 3: 
                break 
                
            opt_val = inputs.get(idx, "")
            
            stdscr.addstr(row, 2, "[ ]", curses.color_pair(1))
            if opt_val:
                stdscr.addstr(row, 3, opt_val, curses.color_pair(2))
                
            stdscr.addstr(row, 7, f"{job['name'][:10]:12}", curses.color_pair(2))
            stdscr.addstr(row, 20, f"{job['user'][:10]:12}", curses.color_pair(2))
            stdscr.addstr(row, 34, "BCH", curses.color_pair(4))
            stdscr.addstr(row, 42, f"{job['cpu']:5.1f}", curses.color_pair(2))
            stdscr.addstr(row, 49, f"{job['status']:10}", curses.color_pair(1 if job['status'] == '*RUNNING' else 2))
            stdscr.addstr(row, 59, f"{job['cmd'][:width-61]}", curses.color_pair(2))
            
            new_inputs[idx] = { 'val': opt_val, 'y': row, 'x': 3, 'job': job }
            row += 1
            
        inputs = { k: v['val'] for k, v in new_inputs.items() }
        
        # 4. Streamlined Legend Bar
        legend_str = "F3=Exit   F5=Refresh   F12=Cancel"
        stdscr.addstr(height - 2, 2, legend_str, curses.color_pair(1))
        
        # Explicit Cursor Placement (Moves exactly where the selection index points)
        if new_inputs and current_row_idx in new_inputs:
            stdscr.move(new_inputs[current_row_idx]['y'], new_inputs[current_row_idx]['x'])
        else:
            stdscr.move(height - 2, 2)
            
        stdscr.refresh()
        
        # 5. Keystroke Listener Loop
        ch = stdscr.getch()
        
        # --- EXIT EVENT HANDLERS ---
        if ch in (curses.KEY_F3, ord('q'), ord('Q'), ord('x'), ord('X'), 27):
            break
            
        # --- MANUAL TICK TRIGGER REFRESH ---
        elif ch in (curses.KEY_F5, ord('r'), ord('R')):
            continue
            
        # --- ARROW NAVIGATION ---
        elif ch == curses.KEY_UP:
            if current_row_idx > 0:
                current_row_idx -= 1
        elif ch == curses.KEY_DOWN:
            if current_row_idx < len(jobs) - 1:
                current_row_idx += 1
            
        # --- CAPTURING COMMAND CODES ---
        elif ch in (ord('4'), ord('5'), ord(' ')):
            if jobs: 
                char_str = " " if ch == ord(' ') else chr(ch)
                inputs[current_row_idx] = char_str.strip()
                    
        # --- ENTER KEY EXECUTOR SUBMITTER ---
        elif ch == 10: 
            for idx, info in new_inputs.items():
                val = inputs.get(idx, "")
                if val == "4":
                    kill_job(info['job']['raw_num'], info['job']['pid'])
                elif val == "5":
                    view_spool(stdscr, info['job']['raw_num'])
                    stdscr.nodelay(True)
                    stdscr.timeout(1000)
            inputs = {}

if __name__ == "__main__":
    curses.wrapper(draw_screen)