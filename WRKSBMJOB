#!/usr/bin/env python3
import os
import sys
import curses
import sqlite3
import time
import getpass

DB_PATH = "/var/lib/os400/qsys.db"

# Dynamically resolve the current session's logged-in user
CURRENT_USER = getpass.getuser()

def update_and_get_submitted_jobs():
    """Queries all historical and current jobs belonging specifically 
    to the logged-on user from the database.
    """
    if not os.path.exists(DB_PATH):
        return []
        
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT job_number, job_name, user, pid, status, command 
        FROM active_jobs 
        WHERE user = ?
        ORDER BY job_number DESC
    """, (CURRENT_USER,))
    jobs = cursor.fetchall()
    
    updated_jobs = []
    for job in jobs:
        job_num, job_name, user, pid, status, command = job
        padded_num = f"{job_num:06d}"
        
        # Verify if running processes died unexpectedly while we weren't looking
        if status == '*RUNNING' and pid > 0:
            try:
                os.kill(pid, 0) 
            except OSError:
                status = '*OUTQ'
                cursor.execute("UPDATE active_jobs SET status = '*OUTQ' WHERE job_number = ?", (job_num,))
                conn.commit()
                
        updated_jobs.append({
            'num': padded_num,
            'raw_num': job_num,
            'name': job_name,
            'user': user,
            'pid': pid,
            'status': status,
            'cmd': command
        })
            
    conn.close()
    return updated_jobs

def purge_job_and_spool(job_num, pid, status):
    """Executes Option 4 (Delete). Explicitly blocks deletion if the job is 
    actively running, returning an error message string.
    """
    if status == '*RUNNING':
        return f"CPF1338: Job {job_num:06d} is currently running and cannot be deleted."

    # Safely remove the physical spool file from disk
    spool_path = f"/var/lib/os400/splf/JOB_{job_num:06d}.txt"
    if os.path.exists(spool_path):
        try:
            os.remove(spool_path)
        except OSError:
            pass 
            
    # Purge the job entry completely from the SQLite architecture
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM active_jobs WHERE job_number = ?", (job_num,))
    conn.commit()
    conn.close()
    return None

def view_spool(stdscr, job_num):
    """Executes Option 5 to view the spooled stdout text file content."""
    spool_path = f"/var/lib/os400/splf/JOB_{job_num:06d}.txt"
    stdscr.clear()
    stdscr.refresh()
    
    lines = []
    if os.path.exists(spool_path):
        with open(spool_path, "r") as f:
            lines = f.readlines()
    else:
        lines = ["CPF2204: Spool file not found or not generated yet."]

    current_line = 0
    stdscr.nodelay(False) 
    
    while True:
        try:
            stdscr.clear()
            height, width = stdscr.getmaxyx()
            
            stdscr.addstr(0, 2, f"Display Spooled File: JOB_{job_num:06d}.txt", curses.color_pair(2))
            stdscr.addstr(1, 2, "F12=Cancel / Return to WRKSBMJOB", curses.color_pair(1))
            stdscr.hline(2, 0, '-', width)
            
            for i in range(height - 4):
                line_idx = current_line + i
                if line_idx < len(lines):
                    stdscr.addstr(3 + i, 2, lines[line_idx][:width-4].rstrip())
                    
            stdscr.refresh()
        except curses.error:
            pass

        ch = stdscr.getch()
        if ch in (curses.KEY_F12, ord('q'), ord('Q'), ord('c'), ord('C'), 27):
            break
        elif ch in (curses.KEY_DOWN, curses.KEY_NPAGE):
            step = (height - 4) if ch == curses.KEY_NPAGE else 1
            if current_line < len(lines) - (height - 4):
                current_line = min(len(lines) - (height - 4), current_line + step)
        elif ch in (curses.KEY_UP, curses.KEY_PPAGE):
            step = (height - 4) if ch == curses.KEY_PPAGE else 1
            if current_line > 0:
                current_line = max(0, current_line - step)

def draw_screen(stdscr):
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)   
    curses.init_pair(2, curses.COLOR_WHITE, -1)   
    curses.init_pair(3, curses.COLOR_RED, -1)     
    curses.init_pair(4, curses.COLOR_CYAN, -1)    
    
    stdscr.nodelay(True)
    stdscr.timeout(1000) 
    
    # CRITICAL FIX: Track inputs by UNIQUE job number, completely decoupled from visual arrays
    pending_options = {} 
    current_row_idx = 0  
    scroll_top = 0      
    error_msg = "" 
    
    while True:
        try:
            stdscr.clear()
            height, width = stdscr.getmaxyx()
            
            jobs = update_and_get_submitted_jobs()
            
            if current_row_idx >= len(jobs):
                current_row_idx = max(0, len(jobs) - 1)
            
            max_jobs_per_page = max(1, height - 12)
            
            # Recalculate sliding window boundaries
            if current_row_idx < scroll_top:
                scroll_top = current_row_idx
            elif current_row_idx >= scroll_top + max_jobs_per_page:
                scroll_top = current_row_idx - max_jobs_per_page + 1
                
            if scroll_top > max(0, len(jobs) - max_jobs_per_page):
                scroll_top = max(0, len(jobs) - max_jobs_per_page)

            # Draw OS/400 Header Standard Layout
            stdscr.addstr(0, 2, "Work with Submitted Jobs", curses.color_pair(1))
            stdscr.addstr(0, width - 24, "OS400-LINUX SYSTEM", curses.color_pair(1))
            
            curr_time = time.strftime("%Y-%m-%d  %H:%M:%S")
            stdscr.addstr(1, width - 24, curr_time, curses.color_pair(2))
            stdscr.addstr(2, 2, f"User: {CURRENT_USER:<10}", curses.color_pair(1))
            
            stdscr.addstr(4, 2, "Type options, press Enter.", curses.color_pair(1))
            stdscr.addstr(5, 4, "4=Delete/Purge   5=Display spool file", curses.color_pair(4))
            
            stdscr.addstr(7, 2, "Opt  Job Number  Job/Subsys  User        Status    Command", curses.color_pair(1))
            stdscr.hline(8, 0, '-', width)
            
            # Pagination Flags
            if len(jobs) > max_jobs_per_page:
                if scroll_top + max_jobs_per_page < len(jobs):
                    stdscr.addstr(7, width - 12, "More...", curses.color_pair(4))
                else:
                    stdscr.addstr(7, width - 12, "Bottom", curses.color_pair(4))

            row = 9
            cursor_coords = None
            visible_jobs = jobs[scroll_top : scroll_top + max_jobs_per_page]
            
            for idx, job in enumerate(visible_jobs):
                absolute_idx = scroll_top + idx
                
                # Fetch options from database key rather than array screen rows
                opt_val = pending_options.get(job['raw_num'], "")
                
                stdscr.addstr(row, 2, "[ ]", curses.color_pair(1))
                if opt_val:
                    stdscr.addstr(row, 3, opt_val, curses.color_pair(2))
                    
                stdscr.addstr(row, 7, f"{job['num']:12}", curses.color_pair(2))
                stdscr.addstr(row, 20, f"{job['name'][:10]:12}", curses.color_pair(2))
                stdscr.addstr(row, 32, f"{job['user'][:10]:12}", curses.color_pair(2))
                
                status_color = curses.color_pair(1) if job['status'] == '*RUNNING' else curses.color_pair(2)
                stdscr.addstr(row, 44, f"{job['status']:10}", status_color)
                stdscr.addstr(row, 56, f"{job['cmd'][:width-58]}", curses.color_pair(2))
                
                if absolute_idx == current_row_idx:
                    cursor_coords = (row, 3)
                    
                row += 1
                
            if error_msg:
                stdscr.addstr(height - 3, 2, error_msg, curses.color_pair(3))
            
            legend_str = "F3=Exit   F5=Refresh   F12=Cancel   PageUp/Dn=Roll"
            stdscr.addstr(height - 2, 2, legend_str, curses.color_pair(1))
            
            if cursor_coords:
                stdscr.move(cursor_coords[0], cursor_coords[1])
            else:
                if height > 2:
                    stdscr.move(height - 2, 2)
                    
            stdscr.refresh()
        except curses.error:
            pass

        ch = stdscr.getch()
        if ch != -1:
            error_msg = "" # Wipe out error message notifications on interaction
        
        if ch in (curses.KEY_F3, ord('q'), ord('Q'), ord('x'), ord('X'), 27):
            break
        elif ch in (curses.KEY_F5, ord('r'), ord('R')):
            continue
        elif ch == curses.KEY_UP:
            if current_row_idx > 0:
                current_row_idx -= 1
        elif ch == curses.KEY_DOWN:
            if current_row_idx < len(jobs) - 1:
                current_row_idx += 1
        elif ch == curses.KEY_PPAGE: 
            if current_row_idx > 0:
                current_row_idx = max(0, current_row_idx - max_jobs_per_page)
        elif ch == curses.KEY_NPAGE: 
            if current_row_idx < len(jobs) - 1:
                current_row_idx = min(len(jobs) - 1, current_row_idx + max_jobs_per_page)
        elif ch in (ord('4'), ord('5'), ord(' ')):
            if jobs and current_row_idx < len(jobs): 
                target_job = jobs[current_row_idx]
                char_str = " " if ch == ord(' ') else chr(ch)
                
                if char_str.strip() == "":
                    pending_options.pop(target_job['raw_num'], None)
                else:
                    pending_options[target_job['raw_num']] = char_str
        elif ch == 10: # Enter Key
            # Process all accumulated commands across all pages in a single loop
            for job_num, val in list(pending_options.items()):
                # Locate the job entry safely inside the primary array
                target_job = next((j for j in jobs if j['raw_num'] == job_num), None)
                if target_job and val in ("4", "5"):
                    if val == "4":
                        err = purge_job_and_spool(
                            target_job['raw_num'], 
                            target_job['pid'], 
                            target_job['status']
                        )
                        if err:
                            error_msg = err
                    elif val == "5":
                        view_spool(stdscr, target_job['raw_num'])
                        stdscr.nodelay(True)
                        stdscr.timeout(1000)
            pending_options = {} # Purge command staging state once executed completely

if __name__ == "__main__":
    try:
        curses.wrapper(draw_screen)
    except KeyboardInterrupt:
        sys.exit(0)