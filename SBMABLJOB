#!/usr/bin/env python3
import sys
import os
import re
import sqlite3
import subprocess
import getpass

DB_PATH = "/var/lib/os400/qsys.db"
SPOOL_DIR = "/var/lib/os400/splf"

def init_environment():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    os.makedirs(SPOOL_DIR, exist_ok=True)
    
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("PRAGMA journal_mode=WAL;")
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS active_jobs (
            job_number INTEGER PRIMARY KEY AUTOINCREMENT,
            job_name TEXT NOT NULL,
            user TEXT NOT NULL,
            pid INTEGER,
            status TEXT NOT NULL,
            command TEXT NOT NULL,
            spool_file TEXT NOT NULL,
            subsys TEXT NOT NULL DEFAULT 'QBATCH',
            submitted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

def parse_cl_args(args_list):
    full_str = " ".join(args_list)
    matches = re.findall(r'(\w+)\((.*?)\)', full_str)
    return {k.upper(): v.strip("'\"") for k, v in matches}

def build_ansible_command(params):
    playbook = params.get("PLAYBOOK", "")
    mod = params.get("MOD", "")
    args = params.get("ARGS", "")
    inv = params.get("INV", "")
    hosts = params.get("HOSTS", "")
    become = params.get("BECOME", "").upper()
    bmethod = params.get("BMETHOD", "")
    extvars = params.get("EXTVARS", "") # NEW: Explicit keyword hook
    check = params.get("CHECK", "").upper()
    vault = params.get("VAULT", "")
    key = params.get("KEY", "")
    vltfile = params.get("VLTFILE", "")

    cmd_parts = []
    if playbook:
        cmd_parts.append("ansible-playbook")
        cmd_parts.append(playbook)
    elif mod:
        cmd_parts.append("ansible")
        cmd_parts.append(hosts if hosts else "all")
        cmd_parts.extend(["-m", mod])
        if args:
            cmd_parts.extend(["-a", args])
    else:
        return None, "CPF0001: Either PLAYBOOK() or MOD() must be specified."

    if inv:
        cmd_parts.extend(["-i", inv])
    elif hosts and playbook:
        if "," in hosts:
            cmd_parts.extend(["-i", f"{hosts},"])
        else:
            cmd_parts.extend(["-i", f"{hosts},"])

    if become in ("*YES", "Y", "YES"):
        cmd_parts.append("-b")
        if bmethod:
            cmd_parts.extend(["--become-method", bmethod])

    # NEW: Safe parsing loop for comma separated extra CLI parameters
    if extvars:
        for item in extvars.split(","):
            if item.strip():
                cmd_parts.extend(["-e", f"'{item.strip()}'"])

    if check in ("*YES", "Y", "YES"):
        cmd_parts.append("-C")

    if vault:
        cmd_parts.extend(["--vault-id", vault])

    if key:
        cmd_parts.extend(["--private-key", key])

    if vltfile:
        cmd_parts.extend(["--vault-password-file", vltfile])

    return " ".join(cmd_parts), None

def submit_ansible_job(params):
    username = getpass.getuser()
    raw_cmd, err = build_ansible_command(params)
    if err:
        print(err)
        sys.exit(1)

    if "JOB" in params:
        job_name = params["JOB"][:10].upper()
    elif params.get("PLAYBOOK"):
        job_name = re.sub(r'[^A-Z0-9]', '', os.path.basename(params["PLAYBOOK"]).split('.')[0].upper())[:10]
    else:
        job_name = f"ANS_{params.get('MOD', 'CMD')}"[:10].upper()

    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO active_jobs (job_name, user, pid, status, command, spool_file, subsys) VALUES (?, ?, ?, ?, ?, ?, ?)",
        (job_name, username, 0, '*JOBQ', raw_cmd, '', 'QBATCH')
    )
    job_number = cursor.lastrowid
    padded_job_num = f"{job_number:06d}"
    spool_file_path = os.path.join(SPOOL_DIR, f"JOB_{padded_job_num}.txt")

    try:
        spool_file = open(spool_file_path, "w")
        try:
            os.chmod(spool_file_path, 0o664)
        except OSError:
            pass

        ansible_env = os.environ.copy()
        ansible_env["PYTHONUNBUFFERED"] = "1"
        ansible_env["ANSIBLE_FORCE_COLOR"] = "0"
        
        if "ENV" in params:
            for item in params["ENV"].split(","):
                if "=" in item:
                    k, v = item.split("=", 1)
                    # Automatically fix lowercase configurations in the environment block
                    k_upper = k.strip().upper() if k.strip().lower().startswith("ansible_") else k.strip()
                    ansible_env[k_upper] = v.strip()

        process = subprocess.Popen(
            raw_cmd,
            shell=True,
            stdout=spool_file,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            env=ansible_env,
            preexec_fn=lambda: os.nice(10)
        )
        pid = process.pid
        status = "*RUNNING"
        print(f"Job {padded_job_num}/{username}/{job_name} submitted to QBATCH.")
    except Exception as e:
        pid = -1
        status = "*ABEND"
        print(f"CPF1124: Ansible execution subsystem failed to initialize. Error: {e}")
        spool_file_path = ""

    cursor.execute(
        "UPDATE active_jobs SET pid = ?, status = ?, spool_file = ? WHERE job_number = ?",
        (pid, status, spool_file_path, job_number)
    )
    conn.commit()
    conn.close()

if __name__ == "__main__":
    init_environment()
    cl_params = parse_cl_args(sys.argv[1:])
    if not cl_params:
        print("Usage Examples:")
        print("  SBMABLJOB 'PLAYBOOK(site.yml) EXTVARS('ansible_connection=local,app_version=2.0')'")
        print("  SBMABLJOB 'PLAYBOOK(deploy.yml) HOSTS(prod) VLTFILE('/var/secure/vpass.txt')'")
        print("  SBMABLJOB 'MOD(ping) HOSTS(all) INV('hosts.ini')'")
        sys.exit(1)
        
    submit_ansible_job(cl_params)