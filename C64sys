#!/usr/bin/env python3
import os
import sys
import curses
import subprocess
import re

# Tracks the currently loaded binary or script file in virtual memory
current_loaded_file = None

def generate_c64_dir():
    """
    Simulates a classic Commodore 1541 disk directory layout.
    Converts file sizes in bytes to 256-byte 'Blocks' for peak authenticity.
    """
    lines = []
    lines.append('0 "BASH ENVIRONMENT " SYS 64')
    try:
        files = os.listdir('.')
        for f in sorted(files):
            if f.startswith('.'): 
                continue
            # Skip directories for execution list simplicity
            if os.path.isdir(f):
                continue
                
            sz = os.path.getsize(f)
            blocks = (sz + 255) // 256 # 256 bytes per sector/block
            
            # Determine classic file type tags
            ext = "PRG"
            if f.endswith(".sh") or f.endswith(".txt"):
                ext = "SEQ"
            elif os.access(f, os.X_OK):
                ext = "PRG"
                
            short_name = f[:16]
            lines.append(f'{blocks:<4} "{short_name:<16}" {ext}')
            
        lines.append("38911 BLOCKS FREE.")
    except Exception:
        lines.append("?DISK DRIVE NOT READY ERROR")
    return lines

def is_python_file(filename):
    """
    Inspects a file to determine if it's a Python script, either by 
    checking its extension or reading the first line for a python shebang.
    """
    if filename.endswith(".py"):
        return True
    try:
        with open(filename, 'r', errors='ignore') as f:
            first_line = f.readline()
            return first_line.startswith("#!") and "python" in first_line
    except Exception:
        return False

def execute_program(filename, run_args, history_lines, stdscr):
    """
    Executes the loaded script or binary, streaming stdout/stderr 
    directly to the blue screen matrix. Safely intercepts Ctrl+C 
    to simulate a classic Commodore BREAK sequence.
    """
    if not filename:
        history_lines.append("?MISSING PROGRAM ERROR")
        return
    if filename == "$":
        history_lines.append("?CANNOT RUN DIRECTORY ERROR")
        return
    if not os.path.exists(filename):
        history_lines.append("?FILE NOT FOUND ERROR")
        return

    # ===================================================================
    # INTERACTIVE ARCADE MODE PATCH (UPDATED)
    # Detects Python via extension OR shebang directive. Suspends the 
    # C64 environment to allow interactive scripts to run full-screen.
    # ===================================================================
    if is_python_file(filename):
        curses.endwin()  # Temporarily close the shell's curses configuration
        try:
            # Explicitly invoke via system python interpreter for maximum stability
            subprocess.run([sys.executable, filename] + run_args)
        except Exception as e:
            print(f"EXECUTION ERROR: {e}")
        stdscr.refresh()  # Restore the shell's layout upon game/script exit
        return
    # ===================================================================

    # Ensure local directory execution prefix is always used for binaries/scripts
    cmd = [f"./{filename}"]
    if filename.endswith(".sh"):
        cmd = ["bash", filename]
        
    if run_args:
        cmd.extend(run_args)

    process = None
    try:
        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1
        )
        
        # Stream output line-by-line so long processes don't freeze the screen
        while True:
            line = process.stdout.readline()
            if not line and process.poll() is not None:
                break
            if line:
                clean_line = line.rstrip('\r\n')
                # Filter printable characters
                clean_line = "".join(c for c in clean_line if c.isprintable())
                history_lines.append(clean_line.upper())
                # Dynamic refresh mid-stream
                render_c64_screen(stdscr, history_lines, "", 0)
                
        return_code = process.wait()
        
        # If the script finishes with an explicit error code, report it
        if return_code != 0:
            history_lines.append(f"?RE-RUN ERROR CODE: {return_code}")
            
    except KeyboardInterrupt:
        # CAPTURES CTRL+C: Safely kills hanging scripts and returns to BASIC cleanly
        if process:
            process.terminate()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
                
        history_lines.append("")
        history_lines.append("?BREAK ERROR") # Classic C64 breakout response
        
    except Exception as e:
        history_lines.append(f"?OS EXECUTION ERROR: {str(e).upper()}")

def render_c64_screen(stdscr, history_lines, input_buffer, cursor_pos):
    stdscr.clear()
    height, width = stdscr.getmaxyx()
    
    # Pair 1: Cyan text on Blue background. Pair 2: Inverted for solid cursor block.
    stdscr.bkgd(' ', curses.color_pair(1))
    
    margin = 2
    max_text_width = width - (margin * 2)
    
    # Process text wrapping across the entire history canvas
    all_wrapped = []
    for line in history_lines:
        if not line:
            all_wrapped.append("")
            continue
        for i in range(0, len(line), max_text_width):
            all_wrapped.append(line[i:i+max_text_width])
            
    # Process wrapping for the active typing line
    input_wrapped = []
    for i in range(0, max(1, len(input_buffer)), max_text_width):
        input_wrapped.append(input_buffer[i:i+max_text_width])
        
    # Calculate exactly how many rows of history can be safely drawn
    max_visible_rows = height - len(input_wrapped) - 2
    visible_history = all_wrapped[-max_visible_rows:] if len(all_wrapped) > max_visible_rows else all_wrapped
    
    # Draw history blocks
    current_row = 1
    for line in visible_history:
        if current_row < height - len(input_wrapped):
            stdscr.addstr(current_row, margin, line, curses.color_pair(1))
            current_row += 1
            
    # Draw user input buffer lines
    input_start_row = current_row
    for idx, chunk in enumerate(input_wrapped):
        if input_start_row + idx < height:
            stdscr.addstr(input_start_row + idx, margin, chunk, curses.color_pair(1))
            
    # Calculate and draw block cursor matrix
    cursor_chunk_idx = cursor_pos // max_text_width
    cursor_col_offset = cursor_pos % max_text_width
    
    target_cursor_row = input_start_row + cursor_chunk_idx
    target_cursor_col = margin + cursor_col_offset
    
    if 0 <= target_cursor_row < height and 0 <= target_cursor_col < width:
        char_under_cursor = input_buffer[cursor_pos] if cursor_pos < len(input_buffer) else " "
        stdscr.addstr(target_cursor_row, target_cursor_col, char_under_cursor, curses.color_pair(2) | curses.A_BLINK)
        
    stdscr.refresh()

def main_c64_shell(stdscr):
    global current_loaded_file
    
    # Initialize authentic Commodore palette profiles
    curses.start_color()
    curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLUE)  # Cyan Text on Blue Screen
    curses.init_pair(2, curses.COLOR_BLUE, curses.COLOR_CYAN)  # Inverted text background block
    stdscr.keypad(True)
    
    # Classic startup sequence
    history_lines = [
        "**** COMMODORE 64 BASIC V2 ****",
        "",
        " 64K RAM SYSTEM  38911 BASIC BYTES FREE",
        "",
        "READY."
    ]
    
    input_buffer = ""
    field_cursor_pos = 0
    
    while True:
        render_c64_screen(stdscr, history_lines, input_buffer, field_cursor_pos)
        ch = stdscr.getch()
        
        # Horizontal Movement Navigation Controls
        if ch == curses.KEY_LEFT:
            if field_cursor_pos > 0:
                field_cursor_pos -= 1
        elif ch == curses.KEY_RIGHT:
            if field_cursor_pos < len(input_buffer):
                field_cursor_pos += 1
                
        # Character Deletions
        elif ch in (curses.KEY_BACKSPACE, 127, 8):
            if field_cursor_pos > 0:
                input_buffer = input_buffer[:field_cursor_pos - 1] + input_buffer[field_cursor_pos:]
                field_cursor_pos -= 1
        elif ch == curses.KEY_DC: # Delete Key
            if field_cursor_pos < len(input_buffer):
                input_buffer = input_buffer[:field_cursor_pos] + input_buffer[field_cursor_pos + 1:]
                
        # Command Processing Line (Enter Key Execution)
        elif ch in (10, 13):
            history_lines.append(input_buffer)
            cmd_clean = input_buffer.strip()
            input_buffer = ""
            field_cursor_pos = 0
            
            if not cmd_clean:
                history_lines.append("READY.")
                continue
                
            cmd_upper = cmd_clean.upper()
            
            # EXIT Command
            if cmd_upper == "EXIT":
                break
                
            # NEW Command
            elif cmd_upper == "NEW":
                current_loaded_file = None
                history_lines.append("READY.")
                
            # HOME / CLEAR Screen Command
            elif cmd_upper in ("HOME", "CLEAR", "CLR"):
                history_lines = [
                    "**** COMMODORE 64 BASIC V2 ****",
                    "",
                    " 64K RAM SYSTEM  38911 BASIC BYTES FREE",
                    "",
                    "READY."
                ]
                
            # DIR / CATALOG Command Shortcut
            elif cmd_upper in ("DIR", "CATALOG"):
                history_lines.extend(generate_c64_dir())
                history_lines.append("READY.")
                
            # LOAD Command Interpreter
            elif cmd_upper.startswith("LOAD"):
                match = re.search(r'LOAD\s+"([^"]+)"', cmd_clean, re.IGNORECASE)
                if not match:
                    match = re.search(r'LOAD\s+([^\s,]+)', cmd_clean, re.IGNORECASE)
                
                if match:
                    filename = match.group(1)
                    if filename == "$":
                        current_loaded_file = "$"
                        history_lines.append("SEARCHING FOR $")
                        history_lines.append("LOADING")
                        history_lines.append("READY.")
                    else:
                        if os.path.exists(filename):
                            current_loaded_file = filename
                            history_lines.append(f"SEARCHING FOR {filename.upper()}")
                            history_lines.append("LOADING")
                            history_lines.append("READY.")
                        else:
                            history_lines.append(f"SEARCHING FOR {filename.upper()}")
                            history_lines.append("?FILE NOT FOUND ERROR")
                            history_lines.append("READY.")
                else:
                    history_lines.append("?SYNTAX ERROR")
                    history_lines.append("READY.")
                    
            # LIST Command Interpreter
            elif cmd_upper == "LIST":
                if current_loaded_file == "$":
                    history_lines.extend(generate_c64_dir())
                elif current_loaded_file:
                    try:
                        with open(current_loaded_file, "r") as f:
                            file_lines = f.readlines()
                        bas_line = 10
                        for fl in file_lines:
                            history_lines.append(f"{bas_line} {fl.rstrip('\r\n').strip().upper()}")
                            bas_line += 10
                    except Exception as e:
                        history_lines.append(f"?CANNOT READ FILE: {str(e).upper()}")
                history_lines.append("READY.")
                
            # RUN Command Interpreter
            elif cmd_upper.startswith("RUN"):
                parts = cmd_clean.split()
                trailing_args = parts[1:] if len(parts) > 1 else []
                
                if current_loaded_file == "$":
                    history_lines.append("READY.")
                else:
                    execute_program(current_loaded_file, trailing_args, history_lines, stdscr)
                    history_lines.append("READY.")
                    
            # Fallback syntax handling
            else:
                history_lines.append("?SYNTAX ERROR")
                history_lines.append("READY.")
                
        # Character Additions
        elif 32 <= ch <= 126:
            if len(input_buffer) < 250: # Generous input string threshold
                input_buffer = input_buffer[:field_cursor_pos] + chr(ch) + input_buffer[field_cursor_pos:]
                field_cursor_pos += 1

if __name__ == "__main__":
    try:
        curses.wrapper(main_c64_shell)
    except KeyboardInterrupt:
        sys.exit(0)